namespace "managarm::svrctl";

// --------------------------------------------------------------------------------------
// Kernel <-> userspace protocol.
// --------------------------------------------------------------------------------------

enum Errors {
	SUCCESS = 0,
	ILLEGAL_REQUEST = 1,
	// For FileUploadResponse: Client needs to send data.
	DATA_REQUIRED = 2,
	DATA_MISMATCH = 3,
	// For DeviceBindResponse: The driver cannot bind to this device.
	DEVICE_NOT_SUPPORTED = 4
}

struct File {
	string path;
}

struct Token {
	string identifier;
}

struct Description {
	string name;
	string exec;
	File[] files;
	Token[] owned_tokens;
}

message FileUploadRequest 1 {
head(128):
	string name;
	uint8 with_data;
}

message FileUploadResponse 2 {
head(128):
	Errors error;
}

message RunServerRequest 3 {
head(128):
	Description description;
}

message RunServerResponse 4 {
head(128):
	Errors error;
}

message DeviceBindRequest 5 {
head(128):
	int64 mbus_id;
}

message DeviceBindResponse 6 {
head(128):
	Errors error;
}

// Registers a userspace-backed kernel I/O channel. On success, the kernel provides the
// following rings via the ringbuf protocol (see ringbuf.bragi) after the response:
// * The output ring (RELIABLE, STREAM) of the given size; the kernel is the producer.
// * If in_ring_size is non-zero: the input ring (RELIABLE, STREAM); the kernel is the consumer.
// The kernel flushes the output ring whenever output needs to be written out immediately.
message ProvideIoChannelRequest 7 {
head(128):
	string tag;
	string descriptive_tag;
	uint64 out_ring_size;
	uint64 in_ring_size;
}

message ProvideIoChannelResponse 8 {
head(128):
	Errors error;
}
