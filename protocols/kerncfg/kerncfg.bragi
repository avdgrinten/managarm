namespace "managarm::kerncfg";

enum Error {
	SUCCESS = 0,
	ILLEGAL_REQUEST = 1,
	WOULD_BLOCK = 2,
	NO_SUCH_DEVICE = 3
}

message GetCmdlineRequest 1 {
head(128):
}

consts GetBufferContentsFlags uint64 {
	// Only retrieve a single record instead of filling up the buffer
	ONE_RECORD = 1,
	// Do not wait for the buffer to be filled, return WOULD_BLOCK instead
	NO_WAIT = 2
}

message GetBufferContentsRequest 2 {
head(128):
	uint64 watermark;
	uint64 size;
	uint64 dequeue;
	uint64 flags;
}

message SvrResponse 3 {
head(128):
	Error error;

	tags {
		tag(1) uint64 size;
		tag(2) uint64 effective_dequeue;
		tag(3) uint64 new_dequeue;
	}
}

message GetMemoryInformationRequest 4 {
head(128):
}

message GetMemoryInformationResponse 5 {
head(128):
	Error error;
	uint64 total_usable_memory;
	uint64 available_memory;
	uint64 memory_unit;
}

message GetNumCpuRequest 6 {
head(128):
}

message GetNumCpuResponse 7 {
head(128):
	Error error;
	uint64 num_cpu;
}

message GetAcpiRsdpRequest 8 {
head(128):
}

message GetAcpiRsdpResponse 9 {
head(128):
	Error error;
	uint64 rsdp;
}

message GetDeviceTreeRequest 10 {
head(128):
}

message GetDeviceTreeResponse 11 {
head(128):
	Error error;
	uint64 address;
	uint64 size;
}

struct HierarchyNode {
	uint64 id;
	uint64 parent_id;
	uint64 charged_memory;
	uint64 charged_swap;
	uint64 charged_kernel;
	string tag;
}

message GetHierarchyRequest 12 {
head(128):
}

message GetHierarchyResponse 13 {
head(128):
	Error error;
tail:
	HierarchyNode[] nodes;
}

// Registers a userspace-backed kernel I/O channel.
// On success, userspace establishes the rings of the channel on the same lane via the shm protocol (see shm.bragi),
// one after another; the kernel is the provider and chooses the ring sizes.
// Both rings are RELIABLE and STREAM:
// * First, the output ring; userspace is the consumer.
// * Second, the input ring; userspace is the producer. It only exists if has_input is set.
// The kernel flushes the output ring whenever output needs to be written out immediately.
message ProvideIoChannelRequest 14 {
head(128):
	string tag;
	string descriptive_tag;
	uint8 has_input;
}

message ProvideIoChannelResponse 15 {
head(128):
	Error error;
}

enum KernelDeviceResourceKind {
	MMIO = 0,
	IO = 1
}

// A device that the kernel drives itself (e.g., the boot framebuffer or UART).
// The resources are the physical address and I/O port ranges that the kernel accesses.
struct KernelDevice {
	uint64 id;
	string name;
}

struct KernelDeviceResource {
	uint64 device;
	KernelDeviceResourceKind kind;
	uint64 base;
	uint64 length;
}

struct KernelFramebuffer {
	uint64 device;
	uint32 pitch;
	uint32 width;
	uint32 height;
	uint32 bpp;
	uint32 fb_type;
}

message ListKernelDevicesRequest 16 {
head(128):
}

message ListKernelDevicesResponse 17 {
head(128):
	Error error;
tail:
	tags {
		tag(1) KernelDevice[] devices;
		tag(2) KernelDeviceResource[] resources;
		tag(3) KernelFramebuffer[] framebuffers;
	}
}

// Makes the kernel give up the device for good.
message ClaimKernelDeviceRequest 18 {
head(128):
	uint64 id;
}
